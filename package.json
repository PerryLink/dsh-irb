{
  "name": "dsh-irb",
  "version": "0.1.1",
  "description": "Ethics-application checklist for DeepSeek Harness: 18-item keyword checklist (title, PI, purpose, design, participants, recruitment, consent, assent, risks, benefits, confidentiality, vulnerable groups, compensation, conflicts, retention, dissemination, animal ethics, biosafety), an advisory risk level with required safeguards from structured flags, Markdown/SARIF export and REP evidence. Not an IRB decision and not legal advice.",
  "author": "PerryLink contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryLink/dsh-irb.git"
  },
  "homepage": "https://github.com/PerryLink/dsh-irb#readme",
  "bugs": {
    "url": "https://github.com/PerryLink/dsh-irb/issues"
  },
  "private": false,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "README-zh.md",
    "LICENSE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "research",
    "ethics",
    "irb",
    "consent",
    "risk"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.9.0",
    "dsh": ">=0.2.1-0 <0.3.0 || >=0.2.2-0 <0.3.0"
  },
  "packageManager": "pnpm@12.16.1",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/dsh-tools": ">=0.2.1-0 <0.3.0 || >=0.2.2-0 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.5-alpha.1",
    "@perrylink/dsh-research-core": "^0.1.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@perrylink/dsh-research-core": "file:../dsh-research-core",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "license": "Apache-2.0"
}
